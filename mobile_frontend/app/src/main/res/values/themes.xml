<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>

    <!-- Calculator Button Styles -->
    <style name="CalcButton">
        <item name="android:backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/btn_neutral_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:outlineProvider">none</item>
        <item name="android:background">@drawable/bg_button_neutral</item>
    </style>
    <style name="CalcButtonPrimary">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="CalcButtonAccent">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/btn_accent_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/bg_button_accent</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="CalcButtonWide">
        <item name="android:backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/btn_neutral_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:background">@drawable/bg_button_neutral</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
